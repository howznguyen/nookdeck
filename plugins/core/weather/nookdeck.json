{
  "id": "core.weather",
  "name": "Weather",
  "version": "1.0.0",
  "author": "Nookdeck",
  "description": "Current weather, hourly and daily forecast from Home Assistant or Open-Meteo",
  "permissions": {
    "network": [
      "api.open-meteo.com",
      "air-quality-api.open-meteo.com",
      "geocoding-api.open-meteo.com"
    ]
  },
  "widgets": [
    {
      "id": "weather",
      "name": "Weather",
      "render": "custom:weather",
      "sizes": [
        "2x1",
        "2x2",
        "4x2"
      ],
      "settings": [
        {
          "key": "source",
          "type": "select",
          "label": "Source",
          "default": "auto",
          "options": [
            "auto",
            "hass",
            "open-meteo"
          ]
        },
        {
          "key": "entity",
          "type": "entity",
          "label": "Home Assistant weather entity"
        },
        {
          "key": "locationName",
          "type": "string",
          "label": "Location"
        },
        {
          "key": "lat",
          "type": "number",
          "label": "Latitude"
        },
        {
          "key": "lon",
          "type": "number",
          "label": "Longitude"
        },
        {
          "key": "show",
          "type": "select",
          "label": "Show",
          "default": "auto",
          "options": [
            "auto",
            "now",
            "hourly",
            "daily"
          ]
        },
        {
          "key": "units",
          "type": "select",
          "label": "Units",
          "options": [
            "metric",
            "imperial"
          ]
        }
      ],
      "preview": {
